# =====================================================================
# SERAPH BUILD CONSTRUCTION — Environment configuration
# Copy to .env (Docker reads these via docker-compose environment).
# On shared hosting, edit api/config/database.php instead.
# =====================================================================

APP_ENV=local

# Database (matches docker-compose.yml)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=seraph_construction
DB_USERNAME=seraph
DB_PASSWORD=seraph_password

# For XAMPP local MySQL (not Docker), use:
# DB_HOST=127.0.0.1
# DB_DATABASE=seraph_construction
# DB_USERNAME=root
# DB_PASSWORD=
