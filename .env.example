# =====================================================================
# SERAPH BUILD CONSTRUCTION — Environment configuration
# Copy this file to .env and fill in your REAL values.
# .env is gitignored and blocked from web access by .htaccess.
#
# Where should .env live on shared hosting?
#   Prefer placing it one level ABOVE public_html (i.e. next to public_html)
#   so it can never be served over HTTP even if the server is misconfigured.
#   The app looks for .env in the repo root, then one level up.
#
# SECURITY: with APP_ENV=production the app FAILS CLOSED — if DB_*
# variables are missing it errors out instead of using any fallback.
# =====================================================================

# local | production
#   local      -> uses XAMPP/docker defaults if DB_* are left unset (dev only)
#   production -> REQUIRES all DB_* below; no fallback credentials
APP_ENV=local

# Database — replace with YOUR database credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<your_db_name>
DB_USERNAME=<your_db_user>
DB_PASSWORD=change_me_to_a_strong_password

# Hostinger (hPanel -> Databases -> MySQL) looks like:
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=<your_db_name>
# DB_USERNAME=<your_db_user>
# DB_PASSWORD=YourStrongPassword

# Optional email notifications (contact form → admin inbox)
# When MAIL_TO is set, new contact enquiries trigger a plain-text email via PHP mail().
# On Hostinger, use an address on your domain for best deliverability.
# MAIL_TO=seraphbuildconstruction@gmail.com
# MAIL_FROM=noreply@yourdomain.com
# MAIL_FROM_NAME=Seraph Build Construction
