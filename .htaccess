# =====================================================================
# SERAPH BUILD CONSTRUCTION — Apache/LiteSpeed .htaccess (Hostinger)
# Place the CONTENTS of this repo into public_html/
# =====================================================================

# No directory browsing
Options -Indexes

# Serve the PHP entry point first
DirectoryIndex index.php

# ---------------------------------------------------------------------
# PRODUCTION DATABASE CREDENTIALS (Hostinger)
# Fill these in from your Hostinger hPanel -> Databases -> MySQL
# and UNCOMMENT the block. They override the local dev defaults in
# api/config/database.php. Works on Apache (mod_env) and LiteSpeed.
# ---------------------------------------------------------------------
# <IfModule mod_env.c>
#   SetEnv DB_HOST "localhost"
#   SetEnv DB_PORT "3306"
#   SetEnv DB_DATABASE "u123456789_seraph"
#   SetEnv DB_USERNAME "u123456789_seraph"
#   SetEnv DB_PASSWORD "YourStrongPassword"
#   SetEnv APP_ENV "production"
# </IfModule>

# ---------------------------------------------------------------------
# 1. Compression (gzip / deflate)
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# 2. Browser caching
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 year"

  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# 3. MIME types (WebP / WOFF2 served with correct content-type)
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------------
# 4. Security headers
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Never run PHP inside uploads (defense in depth) ---
  RewriteRule ^uploads/.*\.php$ - [F,L]

  # --- Block direct access to backend folders (server-served only) ---
  RewriteRule ^api(/|$) - [F,L]
  RewriteRule ^config(/|$) - [F,L]
  RewriteRule ^database(/|$) - [F,L]
  RewriteRule ^docker(/|$) - [F,L]

  # --- Include-only template partials (not meant to be hit directly) ---
  RewriteRule ^partials(/|$) - [F,L]
  RewriteRule ^admin/partials(/|$) - [F,L]
  RewriteRule ^client/partials(/|$) - [F,L]

  # --- Block sensitive files inside uploads ---
  RewriteRule ^uploads/\.htaccess$ - [F,L]
</IfModule>

# ---------------------------------------------------------------------
# Block sensitive files anywhere in the tree
# ---------------------------------------------------------------------
<FilesMatch "^(\.env|\.env\.example|\.gitignore|\.dockerignore|config\.php|database\.php)$">
  Require all denied
</FilesMatch>

# SQL dumps, docker/dev artifacts, deploy helpers must never be served
<FilesMatch "\.(sql|log|ini|bak|old|orig)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(Dockerfile|docker-compose\.yml|nginx\.conf|start-dev-server\.cmd)$">
  Require all denied
</FilesMatch>

# Default deny policy for servers using Allow/Deny (older Apache / LiteSpeed)
<FilesMatch "^(\.env|\.env\.example|\.gitignore|\.dockerignore|Dockerfile|docker-compose\.yml|nginx\.conf|start-dev-server\.cmd)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>