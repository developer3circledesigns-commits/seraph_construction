# =====================================================================
# SERAPH BUILD CONSTRUCTION — Apache/LiteSpeed .htaccess (Hostinger)
# Place the CONTENTS of this repo into public_html/
# =====================================================================

# No directory browsing. -MultiViews is REQUIRED: without it Apache's
# content negotiation serves HTTP 406 to EventSource (Accept:
# text/event-stream) instead of hitting the rewrite rules below, so the
# real-time SSE feeds (admin/client panels) break.
Options -Indexes -MultiViews +FollowSymLinks

# Serve the PHP entry point first
DirectoryIndex index.php

# Hide the PHP version banner (X-Powered-By). ServerTokens is managed
# by the host, but this strips the PHP-level header on Apache/LiteSpeed.
<IfModule mod_headers.c>
  Header unset X-Powered-By
</IfModule>
<IfModule mod_php.c>
  php_flag expose_php Off
</IfModule>

# ---------------------------------------------------------------------
# DATABASE CREDENTIALS (Hostinger)
# Preferred: create a .env file. Place it either inside public_html/
# (the app loads <repo>/.env — it is blocked from HTTP by the rules below)
# or, ideally, one level ABOVE public_html (the app also checks ../.env).
# See .env.example for the format. Never edit api/config/database.php.
#
# Example .env (inside public_html):
#   APP_ENV=production
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_DATABASE=<your_db_name>
#   DB_USERNAME=<your_db_user>
#   DB_PASSWORD=YourStrongPassword
#
# ALTERNATIVE (if you cannot use a .env file): uncomment the block below.
# It works on Apache (mod_env) and LiteSpeed, but keeps secrets in the
# served folder and is only a fallback.
# <IfModule mod_env.c>
#   SetEnv DB_HOST "localhost"
#   SetEnv DB_PORT "3306"
#   SetEnv DB_DATABASE "<your_db_name>"
#   SetEnv DB_USERNAME "<your_db_user>"
#   SetEnv DB_PASSWORD "YourStrongPassword"
#   SetEnv APP_ENV "production"
# </IfModule>

# ---------------------------------------------------------------------
# 1. Compression (gzip / deflate)
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# 2. Browser caching
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 year"

  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# 3. MIME types (WebP / WOFF2 served with correct content-type)
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------------
# 4. Security headers
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://images.unsplash.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Admin contact enquiries: always use flat PHP files (avoids folder redirect loops) ---
  RewriteRule ^admin/contact-inquiries/?$ admin/contact-inquiries.php [L]
  RewriteRule ^admin/contact-inquiry-view/?$ admin/contact-inquiry-view.php [L,QSA]
  RewriteRule ^admin/contact-inquiries/view/?$ admin/contact-inquiry-view.php [L,QSA]

  # --- Never run PHP inside uploads (defense in depth) ---
  RewriteRule ^uploads/.*\.php$ - [F,L]

  # --- Block direct access to the VCS metadata (source/secret disclosure) ---
  RewriteRule ^\.git(/|$) - [F,L]
  RewriteRule ^\.hg(/|$) - [F,L]
  RewriteRule ^\.svn(/|$) - [F,L]

  # --- Block direct access to backend folders (server-served only) ---
  RewriteRule ^api(/|$) - [F,L]
  RewriteRule ^config(/|$) - [F,L]
  RewriteRule ^database(/|$) - [F,L]
  RewriteRule ^docker(/|$) - [F,L]

  # --- Include-only template partials (not meant to be hit directly) ---
  RewriteRule ^partials(/|$) - [F,L]
  RewriteRule ^admin/partials(/|$) - [F,L]
  RewriteRule ^client/partials(/|$) - [F,L]

  # --- Block sensitive files inside uploads ---
  RewriteRule ^uploads/\.htaccess$ - [F,L]

  # ---------------------------------------------------------------------
  # Pretty URLs: hide the .php extension.
  # Internal rewrite: /admin/login  ->  /admin/login.php  (when file exists)
  # ---------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+)$ $1.php [L]

  # ---------------------------------------------------------------------
  # 301 redirect any legacy /foo.php request to the clean /foo URL so the
  # extension never shows in the address bar (bookmarks/caches preserved).
  # ---------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} \.php[?\s] [NC]
  RewriteRule ^(.+)\.php$ /$1 [R=301,L,QSA]
</IfModule>

# ---------------------------------------------------------------------
# Block sensitive files anywhere in the tree
# ---------------------------------------------------------------------
<FilesMatch "^(\.env|\.env\.example|\.gitignore|\.dockerignore|config\.php|database\.php)$">
  Require all denied
</FilesMatch>

# SQL dumps, docker/dev artifacts, deploy helpers must never be served
<FilesMatch "\.(sql|log|ini|bak|old|orig)$">
  Require all denied
</FilesMatch>

# Temporary test helpers — blocked unless the rule is removed
# for the few seconds it takes to run. Delete the files after testing.
<FilesMatch "^(test-db-connection|test-admin-login|test-client-login)\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "^(Dockerfile|docker-compose\.yml|nginx\.conf|start-dev-server\.cmd)$">
  Require all denied
</FilesMatch>

# Default deny policy for servers using Allow/Deny (older Apache / LiteSpeed)
<FilesMatch "^(\.env|\.env\.example|\.gitignore|\.git|\.hg|\.svn|Dockerfile|docker-compose\.yml|nginx\.conf|start-dev-server\.cmd)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>